<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(TargetFramework)</TargetFramework>
    <RootNamespace>Sanctuary.Ps3</RootNamespace>
    <AssemblyName>Sanctuary.Ps3</AssemblyName>
    <Description>Server side of the PlayStation 3 Free Realms client for the Sanctuary emulator family.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="ZLibDotNet" />
  </ItemGroup>

  <ItemGroup>
    <!-- The item definitions the server sends (from Sanctuary's Resources/ClientItemDefinitions.json); read by Gateway/Items.cs. -->
    <EmbeddedResource Include="Data\item_definitions.tsv.gz" LogicalName="Sanctuary.Ps3.item_definitions.tsv.gz" />
    <!-- Sanctuary's item class and category tables (Resources/*.txt, unchanged); read by Gateway/ReferenceData.cs. -->
    <EmbeddedResource Include="Data\ItemClasses.txt" LogicalName="Sanctuary.Ps3.ItemClasses.txt" />
    <EmbeddedResource Include="Data\ItemCategories.txt" LogicalName="Sanctuary.Ps3.ItemCategories.txt" />
    <EmbeddedResource Include="Data\ItemCategoryGroups.txt" LogicalName="Sanctuary.Ps3.ItemCategoryGroups.txt" />
    <!-- The coin store: Sanctuary's Resources/CoinStoreItems.json joined with each item's definition and resell value; read by Gateway/CoinStore.cs. -->
    <EmbeddedResource Include="Data\coin_store.tsv.gz" LogicalName="Sanctuary.Ps3.coin_store.tsv.gz" />
    <EmbeddedResource Include="Data\ResellValues.txt" LogicalName="Sanctuary.Ps3.ResellValues.txt" />
  </ItemGroup>

</Project>
