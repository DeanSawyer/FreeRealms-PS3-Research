<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(TargetFramework)</TargetFramework>
    <RootNamespace>Sanctuary.Ps3</RootNamespace>
    <AssemblyName>Sanctuary.Ps3</AssemblyName>
    <Description>Server side of the PlayStation 3 Free Realms client for the Sanctuary emulator family.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="ZLibDotNet" />
    <!-- The characters' database, as Sanctuary's (Sanctuary.Database.Sqlite / .MySql): SQLite by default, MySQL when asked for. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" />
    <PackageReference Include="MySqlConnector" />
  </ItemGroup>

  <ItemGroup>
    <!-- The item definitions the server sends (from Sanctuary's Resources/ClientItemDefinitions.json); read by Gateway/Items.cs. -->
    <EmbeddedResource Include="Data\item_definitions.tsv.gz" LogicalName="Sanctuary.Ps3.item_definitions.tsv.gz" />
    <!-- Sanctuary's item class and category tables (Resources/*.txt, unchanged); read by Gateway/ReferenceData.cs. -->
    <EmbeddedResource Include="Data\ItemClasses.txt" LogicalName="Sanctuary.Ps3.ItemClasses.txt" />
    <EmbeddedResource Include="Data\ItemCategories.txt" LogicalName="Sanctuary.Ps3.ItemCategories.txt" />
    <EmbeddedResource Include="Data\ItemCategoryGroups.txt" LogicalName="Sanctuary.Ps3.ItemCategoryGroups.txt" />
    <!-- The coin store: Sanctuary's Resources/CoinStoreItems.json joined with each item's definition and resell value; read by Gateway/CoinStore.cs. -->
    <EmbeddedResource Include="Data\coin_store.tsv.gz" LogicalName="Sanctuary.Ps3.coin_store.tsv.gz" />
    <EmbeddedResource Include="Data\ResellValues.txt" LogicalName="Sanctuary.Ps3.ResellValues.txt" />
    <EmbeddedResource Include="Data\PointsOfInterest.txt" LogicalName="Sanctuary.Ps3.PointsOfInterest.txt" />
    <EmbeddedResource Include="Data\npcs.tsv.gz" LogicalName="Sanctuary.Ps3.npcs.tsv.gz" />
    <EmbeddedResource Include="Data\npc_talk.tsv" LogicalName="Sanctuary.Ps3.npc_talk.tsv" />
    <EmbeddedResource Include="Data\npc_notifications.tsv" LogicalName="Sanctuary.Ps3.npc_notifications.tsv" />
    <EmbeddedResource Include="Data\quests.json" LogicalName="Sanctuary.Ps3.quests.json" />
    <EmbeddedResource Include="Data\quest_nodes.tsv" LogicalName="Sanctuary.Ps3.quest_nodes.tsv" />
    <EmbeddedResource Include="Data\pet_definitions.json.gz" LogicalName="Sanctuary.Ps3.pet_definitions.json.gz" />
    <EmbeddedResource Include="Data\pet_items.tsv.gz" LogicalName="Sanctuary.Ps3.pet_items.tsv.gz" />
    <EmbeddedResource Include="Data\merchants.tsv" LogicalName="Sanctuary.Ps3.merchants.tsv" />
    <!-- The Marketplace's Station Cash shop: Sanctuary's Resources/Store*.json, gzipped; read by Gateway/Shop.cs. -->
    <EmbeddedResource Include="Data\shop\*.json.gz" LogicalName="Sanctuary.Ps3.shop.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
