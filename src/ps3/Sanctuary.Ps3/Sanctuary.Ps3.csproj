<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(TargetFramework)</TargetFramework>
    <RootNamespace>Sanctuary.Ps3</RootNamespace>
    <AssemblyName>Sanctuary.Ps3</AssemblyName>
    <Description>Server side of the PlayStation 3 Free Realms client for the Sanctuary emulator family.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="ZLibDotNet" />
  </ItemGroup>

  <ItemGroup>
    <!-- What the client draws for each piece of clothing (tools/gen_clothing_items.py); read by Gateway/Clothing.cs. -->
    <EmbeddedResource Include="..\..\..\bootstrap\data\clothing_items.tsv.gz" LogicalName="Sanctuary.Ps3.clothing_items.tsv.gz" Link="Gateway\clothing_items.tsv.gz" />
  </ItemGroup>

</Project>
