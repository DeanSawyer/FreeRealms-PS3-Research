<Window x:Class="FreeRealms.Bootstrap.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Free Realms · PS3 Bootstrap Manager" Height="720" Width="1060" MinHeight="620" MinWidth="820" Background="{StaticResource BackgroundBrush}" Foreground="White" WindowStartupLocation="CenterScreen"><Grid Margin="30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="FREE REALMS" FontSize="30" FontWeight="Bold"/><TextBlock Text="PLAYSTATION 3 · BOOTSTRAP MANAGER" Foreground="#89A3C4" FontSize="13" Margin="0,4,0,22"/></StackPanel><Border Grid.Row="1" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="22"><StackPanel><TextBlock Text="SERVER CONFIGURATION" Foreground="#9CB5D5" FontWeight="Bold" Margin="0,0,0,12"/><TextBlock Text="PS3 client folder (NPUA30048)" Margin="0,0,0,4"/><DockPanel><Button DockPanel.Dock="Right" Content="Browse" Click="Browse_Click" Margin="8,0,0,0"/><TextBox x:Name="ClientPath" Text=""/></DockPanel><Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="Listen on" Margin="0,0,0,4"/><TextBox x:Name="BindAddress" Text="127.0.0.1"/></StackPanel><StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="Advertised IPv4" Margin="0,0,0,4"/><TextBox x:Name="AdvertiseAddress" Text="127.0.0.1"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="HTTP port" Margin="0,0,0,4"/><TextBox x:Name="HttpPort" Text="80"/></StackPanel></Grid><CheckBox x:Name="DnsEnabled" Content="Enable local DNS service (UDP 53)" Foreground="White" IsChecked="True" Margin="0,16,0,0"/><CheckBox x:Name="MatchLocal" Content="Describe my local files in the patch digest (recommended for a modified or partial install)" Foreground="White" IsChecked="True" Margin="0,8,0,0"/><CheckBox x:Name="UsePython" Content="Use the Python reference server instead of the built-in C# server (needs Python 3 on PATH)" Foreground="White" IsChecked="False" Margin="0,8,0,0"/></StackPanel></Border><DockPanel Grid.Row="2" Margin="0,20,0,18"><TextBlock x:Name="StatusText" Text="● Stopped" Foreground="#CBD5E1" FontWeight="SemiBold" VerticalAlignment="Center" DockPanel.Dock="Right"/><StackPanel Orientation="Horizontal"><Button x:Name="StartButton" Content="Start Services" Click="Start_Click"/><Button x:Name="StopButton" Content="Stop Services" Click="Stop_Click" IsEnabled="False"/><Button Content="Check GitHub" Click="Updates_Click"/></StackPanel></DockPanel><Border Grid.Row="3" Background="{StaticResource PanelBrush}" CornerRadius="12" Padding="16"><DockPanel><TextBlock DockPanel.Dock="Top" Text="LIVE SERVER ACTIVITY" Foreground="#9CB5D5" FontWeight="Bold" Margin="4,0,0,10"/><TextBox x:Name="Logs" IsReadOnly="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Background="#111B2B" BorderThickness="0" Padding="14"/></DockPanel></Border><TextBlock Grid.Row="4" Text="Experimental research build · No copyrighted game assets are included · Do not expose services to the Internet" Foreground="#91A7C3" Margin="0,14,0,0"/></Grid></Window>