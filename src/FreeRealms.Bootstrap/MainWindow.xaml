<Window x:Class="FreeRealms.Bootstrap.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Free Realms PS3 Server Manager"
        Width="1180" Height="780" MinWidth="980" MinHeight="640"
        Background="{StaticResource WindowBrush}"
        FontFamily="{StaticResource UiFont}"
        WindowStartupLocation="CenterScreen">

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="232"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- Sidebar -->
    <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0" Padding="16,22">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="8,0,0,28">
          <TextBlock Text="FREE REALMS" FontSize="20" FontWeight="Bold"/>
          <TextBlock Text="PS3 Server Manager" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,0,0"/>
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource CardBrush}" CornerRadius="8" Padding="12,10">
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="SidebarDot" Width="9" Height="9" Fill="{StaticResource MutedBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
              <TextBlock x:Name="SidebarStatus" Text="Stopped" FontWeight="SemiBold" FontSize="13"/>
            </StackPanel>
            <TextBlock x:Name="VersionText" Text="Version" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="17,3,0,0"/>
          </StackPanel>
        </Border>

        <StackPanel>
          <RadioButton x:Name="NavDashboard" Style="{StaticResource NavButton}" Tag="&#xE80F;" Content="Dashboard" IsChecked="True" Checked="Nav_Checked"/>
          <RadioButton x:Name="NavPlayers" Style="{StaticResource NavButton}" Tag="&#xE716;" Content="Players" Checked="Nav_Checked"/>
          <RadioButton x:Name="NavCharacters" Style="{StaticResource NavButton}" Tag="&#xE77B;" Content="Characters" Checked="Nav_Checked"/>
          <RadioButton x:Name="NavGameplay" Style="{StaticResource NavButton}" Tag="&#xE7FC;" Content="Gameplay" Checked="Nav_Checked"/>
          <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" Tag="&#xE713;" Content="Settings" Checked="Nav_Checked"/>
          <RadioButton x:Name="NavLogs" Style="{StaticResource NavButton}" Tag="&#xE8A5;" Content="Logs" Checked="Nav_Checked"/>
          <RadioButton x:Name="NavDiagnostics" Style="{StaticResource NavButton}" Tag="&#xE9D9;" Content="Diagnostics" Checked="Nav_Checked"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Pages -->
    <Grid Grid.Column="1" Margin="32,26,32,24">

      <!-- Dashboard -->
      <ScrollViewer x:Name="PageDashboard" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
              <Button x:Name="TestRunButton" Style="{StaticResource SecondaryButton}" Click="TestRun_Click" ToolTip="Start RPCS3 on the game; when you close it, a report zip is saved to the Desktop">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE768;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                  <TextBlock Text="Test run in RPCS3"/>
                </StackPanel>
              </Button>
              <Button x:Name="StartButton" Style="{StaticResource PrimaryButton}" Click="Start_Click" Margin="0">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE7E8;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                  <TextBlock Text="Start server"/>
                </StackPanel>
              </Button>
              <Button x:Name="StopButton" Style="{StaticResource DangerButton}" Click="Stop_Click" Margin="0" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="&#xE71A;" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,8,0"/>
                  <TextBlock Text="Stop server"/>
                </StackPanel>
              </Button>
            </StackPanel>
            <StackPanel>
              <TextBlock Text="Dashboard" Style="{StaticResource PageTitle}"/>
              <TextBlock Text="The DNS stand-in, the web server and the game server the PS3 client talks to." Style="{StaticResource PageSubtitle}"/>
            </StackPanel>
          </DockPanel>

          <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <DockPanel>
              <Ellipse x:Name="StatusDot" Width="14" Height="14" Fill="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
              <StackPanel>
                <TextBlock x:Name="StatusTitle" Text="Server stopped" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock x:Name="StatusDetail" Text="Press Start server, or Test run in RPCS3 to start everything at once." Style="{StaticResource Hint}"/>
              </StackPanel>
            </DockPanel>
          </Border>

          <UniformGrid Columns="3" Margin="0,0,0,16">
            <Border Style="{StaticResource Card}" Margin="0,0,8,0">
              <StackPanel>
                <TextBlock Text="DNS" Style="{StaticResource CardTitle}"/>
                <TextBlock x:Name="DnsState" Text="Stopped" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock x:Name="DnsDetail" Text="Points the game's host names at this PC" Style="{StaticResource Hint}"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="4,0,4,0">
              <StackPanel>
                <TextBlock Text="WEB SERVER" Style="{StaticResource CardTitle}"/>
                <TextBlock x:Name="WebState" Text="Stopped" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock x:Name="WebDetail" Text="Patch digest, assets, accounts and characters" Style="{StaticResource Hint}"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="8,0,0,0">
              <StackPanel>
                <TextBlock Text="GAME SERVER" Style="{StaticResource CardTitle}"/>
                <TextBlock x:Name="GameState" Text="Stopped" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock x:Name="GameDetail" Text="The world, your character, items and jobs" Style="{StaticResource Hint}"/>
              </StackPanel>
            </Border>
          </UniformGrid>

          <UniformGrid Columns="4" Margin="0,0,0,16">
            <Border Style="{StaticResource Card}" Margin="0,0,8,0">
              <StackPanel>
                <TextBlock Text="UPTIME" Style="{StaticResource CardTitle}"/>
                <TextBlock x:Name="UptimeText" Text="—" Style="{StaticResource StatValue}"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="4,0,4,0">
              <StackPanel>
                <TextBlock Text="PLAYERS CONNECTED" Style="{StaticResource CardTitle}"/>
                <TextBlock x:Name="PlayersText" Text="0" Style="{StaticResource StatValue}"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="4,0,4,0">
              <StackPanel>
                <TextBlock Text="PACKETS RECEIVED" Style="{StaticResource CardTitle}"/>
                <TextBlock x:Name="PacketsText" Text="0" Style="{StaticResource StatValue}"/>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="8,0,0,0">
              <StackPanel>
                <TextBlock Text="CHARACTER" Style="{StaticResource CardTitle}"/>
                <TextBlock x:Name="CharacterText" Text="—" Style="{StaticResource StatValue}" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="SavedCharactersText" Text="" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
            </Border>
          </UniformGrid>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Content="Open logs" Style="{StaticResource SecondaryButton}" Padding="12,5" Margin="0" Click="OpenLogs_Click"/>
                <TextBlock Text="RECENT ACTIVITY" Style="{StaticResource CardTitle}" VerticalAlignment="Center" Margin="0"/>
              </DockPanel>
              <ItemsControl x:Name="RecentLog">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,3">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding TimeText}" Foreground="{StaticResource MutedBrush}" FontFamily="{StaticResource MonoFont}" FontSize="12"/>
                      <TextBlock Grid.Column="1" Text="{Binding Source}" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                      <TextBlock Grid.Column="2" Text="{Binding Message}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- Players -->
      <DockPanel x:Name="PagePlayers" Visibility="Collapsed">
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="Players" Style="{StaticResource PageTitle}"/>
          <TextBlock Text="PS3 clients connected to the game server, refreshed every second." Style="{StaticResource PageSubtitle}"/>
        </StackPanel>
        <Border Style="{StaticResource Card}" Padding="0">
          <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="20,14,20,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1.6*"/>
                <ColumnDefinition Width="1.4*"/>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="0.9*"/>
                <ColumnDefinition Width="1.1*"/>
                <ColumnDefinition Width="1.1*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="ONLINE ID" Style="{StaticResource CardTitle}" Margin="0"/>
              <TextBlock Grid.Column="1" Text="ADDRESS" Style="{StaticResource CardTitle}" Margin="0"/>
              <TextBlock Grid.Column="2" Text="JOB" Style="{StaticResource CardTitle}" Margin="0"/>
              <TextBlock Grid.Column="3" Text="STATE" Style="{StaticResource CardTitle}" Margin="0"/>
              <TextBlock Grid.Column="4" Text="PACKETS" Style="{StaticResource CardTitle}" Margin="0"/>
              <TextBlock Grid.Column="5" Text="LAST PACKET" Style="{StaticResource CardTitle}" Margin="0"/>
              <TextBlock Grid.Column="6" Text="CONNECTED" Style="{StaticResource CardTitle}" Margin="0"/>
            </Grid>
            <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource LineBrush}"/>
            <Grid>
              <TextBlock x:Name="NoPlayers" Text="No PS3 client is connected. Start the server, then start the game in RPCS3." Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40"/>
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="PlayersList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="20,12">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1.6*"/>
                            <ColumnDefinition Width="1.4*"/>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="0.9*"/>
                            <ColumnDefinition Width="1.1*"/>
                            <ColumnDefinition Width="1.1*"/>
                          </Grid.ColumnDefinitions>
                          <StackPanel>
                            <TextBlock Text="{Binding OnlineId}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding Character}" Style="{StaticResource Hint}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                          </StackPanel>
                          <TextBlock Grid.Column="1" Text="{Binding Address}" FontFamily="{StaticResource MonoFont}" FontSize="12" VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="2" Text="{Binding Job}" VerticalAlignment="Center"/>
                          <Border Grid.Column="3" x:Name="StatePill" Background="{StaticResource CardAltBrush}" CornerRadius="10" Padding="10,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="{Binding State}" FontSize="12"/>
                          </Border>
                          <TextBlock Grid.Column="4" Text="{Binding Packets}" VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="5" Text="{Binding LastPacket}" VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="6" Text="{Binding Connected}" VerticalAlignment="Center"/>
                        </Grid>
                      </Border>
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding State}" Value="In world">
                          <Setter TargetName="StatePill" Property="Background" Value="#14532D"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding State}" Value="Logged in">
                          <Setter TargetName="StatePill" Property="Background" Value="{StaticResource AccentSoftBrush}"/>
                        </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </DockPanel>
        </Border>
      </DockPanel>

      <!-- Characters -->
      <DockPanel x:Name="PageCharacters" Visibility="Collapsed">
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="Characters" Style="{StaticResource PageTitle}"/>
          <TextBlock Style="{StaticResource PageSubtitle}" TextWrapping="Wrap"
                     Text="Characters saved on this server, up to 10 as in Sanctuary. With the character wheel fix, character select turns through them with the D-pad, ending on New character. The one marked Shown next comes first."/>
        </StackPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,16">
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Refresh" Style="{StaticResource SecondaryButton}" Margin="0" Click="RefreshCharacters_Click"/>
            <CheckBox x:Name="CreatorNextSwitch" Style="{StaticResource Switch}" Margin="0" Click="CreatorNext_Click">
              <StackPanel>
                <TextBlock Text="Next login opens the character creator" FontWeight="SemiBold"/>
                <TextBlock x:Name="CreatorNextHint" Text="Make another character; the ones below are kept. Turns itself off once the new character is made." Style="{StaticResource Hint}" TextWrapping="Wrap"/>
              </StackPanel>
            </CheckBox>
          </DockPanel>
        </Border>
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,16">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
              <Button Content="Put the panel in..." Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="PanelIn_Click"/>
              <Button x:Name="PanelOutButton" Content="Take it out" Style="{StaticResource SecondaryButton}" Margin="0" Click="PanelOut_Click"/>
            </StackPanel>
            <StackPanel Margin="0,0,16,0">
              <TextBlock Text="Select panel" FontWeight="SemiBold"/>
              <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                         Text="Puts the PC client's character select panel (characterSelectV2.gfx) in place of the select screen's prompt and fills it with the characters below, again before each test run. D-pad left and right choose, X plays (or makes a new character). Needs the character wheel fix. Close the game first."/>
            </StackPanel>
          </DockPanel>
        </Border>
        <Border Style="{StaticResource Card}" Padding="0">
          <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="20,14,20,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.4*"/>
                <ColumnDefinition Width="1.3*"/>
                <ColumnDefinition Width="1.3*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="CHARACTER" Style="{StaticResource CardTitle}" Margin="0"/>
              <TextBlock Grid.Column="1" Text="MADE" Style="{StaticResource CardTitle}" Margin="0"/>
              <TextBlock Grid.Column="2" Text="LAST PLAYED" Style="{StaticResource CardTitle}" Margin="0"/>
              <TextBlock Grid.Column="3" Text="" Width="232" Style="{StaticResource CardTitle}" Margin="0"/>
            </Grid>
            <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource LineBrush}"/>
            <Grid>
              <TextBlock x:Name="NoCharacters" Text="No characters yet. Make one in the game's character creator." Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40"/>
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="CharactersList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="20,12">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.4*"/>
                            <ColumnDefinition Width="1.3*"/>
                            <ColumnDefinition Width="1.3*"/>
                            <ColumnDefinition Width="Auto"/>
                          </Grid.ColumnDefinitions>
                          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel>
                              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                              <TextBlock Text="{Binding Detail}" Style="{StaticResource Hint}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Border x:Name="ShownPill" Background="{StaticResource AccentSoftBrush}" CornerRadius="10" Padding="10,3" Margin="12,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                              <TextBlock Text="Shown next" FontSize="12"/>
                            </Border>
                          </StackPanel>
                          <TextBlock Grid.Column="1" Text="{Binding Made}" VerticalAlignment="Center"/>
                          <TextBlock Grid.Column="2" Text="{Binding LastPlayed}" VerticalAlignment="Center"/>
                          <StackPanel Grid.Column="3" Orientation="Horizontal" Width="232" HorizontalAlignment="Right">
                            <Button x:Name="ShowNextButton" Content="Show next" Style="{StaticResource SecondaryButton}" Tag="{Binding Guid}" Click="ShowNext_Click"/>
                            <Button Content="Delete" Style="{StaticResource DangerButton}" Margin="0" Tag="{Binding Guid}" Click="DeleteCharacter_Click"/>
                          </StackPanel>
                        </Grid>
                      </Border>
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding ShownNext}" Value="True">
                          <Setter TargetName="ShownPill" Property="Visibility" Value="Visible"/>
                          <Setter TargetName="ShowNextButton" Property="IsEnabled" Value="False"/>
                        </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </DockPanel>
        </Border>
      </DockPanel>

      <!-- Gameplay -->
      <ScrollViewer x:Name="PageGameplay" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="820" HorizontalAlignment="Left">
          <DockPanel>
            <Button DockPanel.Dock="Right" x:Name="ApplyGameplayButton" Content="Save and restart server" Style="{StaticResource PrimaryButton}" Margin="0" VerticalAlignment="Top" Click="ApplyGameplay_Click"/>
            <StackPanel>
              <TextBlock Text="Gameplay" Style="{StaticResource PageTitle}"/>
              <TextBlock Text="What the game server sends and how it answers. Changes apply the next time the server starts." Style="{StaticResource PageSubtitle}"/>
            </StackPanel>
          </DockPanel>

          <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
              <TextBlock Text="SERVER BEHAVIOUR" Style="{StaticResource CardTitle}"/>
              <CheckBox x:Name="SanctuaryFlowSwitch" Style="{StaticResource Switch}">
                <StackPanel>
                  <TextBlock Text="Sanctuary flow" FontWeight="SemiBold"/>
                  <TextBlock Text="Send what the PC server Sanctuary sends when you enter the world, and answer the inventory and job switches. Recommended." Style="{StaticResource Hint}"/>
                </StackPanel>
              </CheckBox>
              <CheckBox x:Name="StarterItemsSwitch" Style="{StaticResource Switch}">
                <StackPanel>
                  <TextBlock Text="Starter items" FontWeight="SemiBold"/>
                  <TextBlock Text="Give every job its starter outfit and weapon, equipped, as Sanctuary does for a new character." Style="{StaticResource Hint}"/>
                </StackPanel>
              </CheckBox>
              <CheckBox x:Name="WelcomeSwitch" Style="{StaticResource Switch}">
                <StackPanel>
                  <TextBlock Text="Welcome screen" FontWeight="SemiBold"/>
                  <TextBlock Text="Show the welcome screen after loading (basic flow only)." Style="{StaticResource Hint}"/>
                </StackPanel>
              </CheckBox>
              <CheckBox x:Name="GameTimeSwitch" Style="{StaticResource Switch}" Margin="0">
                <StackPanel>
                  <TextBlock Text="Game time" FontWeight="SemiBold"/>
                  <TextBlock Text="Answer the client's request for the game clock (basic flow only)." Style="{StaticResource Hint}"/>
                </StackPanel>
              </CheckBox>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="WORLD AND CHARACTER" Style="{StaticResource CardTitle}"/>

              <TextBlock Text="Jobs" Style="{StaticResource FieldLabel}"/>
              <TextBox x:Name="JobsBox"/>
              <TextBlock Text="all for every job, or job ids separated by commas (for example 1,11,35). Adventurer is always included." Style="{StaticResource Hint}" Margin="0,4,0,16"/>

              <TextBlock Text="Sky" Style="{StaticResource FieldLabel}"/>
              <TextBox x:Name="SkyBox"/>
              <TextBlock Text="The sky named when you enter the zone. Leave sky_wilds24.xml: without a sky the game crashes when you look up." Style="{StaticResource Hint}" Margin="0,4,0,16"/>

              <TextBlock Text="Spawn point" Style="{StaticResource FieldLabel}"/>
              <TextBox x:Name="SpawnBox"/>
              <TextBlock Text="Empty for Sanctuary's spawn, local for a spot inside your install's terrain, or x,y,z." Style="{StaticResource Hint}" Margin="0,4,0,16"/>

              <TextBlock Text="Clothes on entering the world" Style="{StaticResource FieldLabel}"/>
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="Clothes7" Style="{StaticResource Segment}" GroupName="Clothes" Content="All at once (recommended)"/>
                <RadioButton x:Name="Clothes5" Style="{StaticResource Segment}" GroupName="Clothes" Content="One piece at a time"/>
                <RadioButton x:Name="Clothes0" Style="{StaticResource Segment}" GroupName="Clothes" Content="None"/>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- Settings -->
      <ScrollViewer x:Name="PageSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="820" HorizontalAlignment="Left">
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Save settings" Style="{StaticResource PrimaryButton}" Margin="0" VerticalAlignment="Top" Click="SaveSettings_Click"/>
            <StackPanel>
              <TextBlock Text="Settings" Style="{StaticResource PageTitle}"/>
              <TextBlock Text="Where your game and RPCS3 are, and how the server listens." Style="{StaticResource PageSubtitle}"/>
            </StackPanel>
          </DockPanel>

          <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
              <TextBlock Text="GAME CLIENT" Style="{StaticResource CardTitle}"/>

              <TextBlock Text="Client folder (NPUA30048)" Style="{StaticResource FieldLabel}"/>
              <DockPanel Margin="0,0,0,14">
                <Button DockPanel.Dock="Right" Content="Browse" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="BrowseClient_Click"/>
                <TextBox x:Name="ClientBox"/>
              </DockPanel>

              <TextBlock Text="Second client folder (optional)" Style="{StaticResource FieldLabel}"/>
              <DockPanel Margin="0,0,0,14">
                <Button DockPanel.Dock="Right" Content="Browse" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="BrowseExtra_Click"/>
                <TextBox x:Name="ExtraClientBox"/>
              </DockPanel>

              <TextBlock Text="Original patch digest (optional)" Style="{StaticResource FieldLabel}"/>
              <DockPanel Margin="0,0,0,14">
                <Button DockPanel.Dock="Right" Content="Browse" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="BrowseDigest_Click"/>
                <TextBox x:Name="DigestBox"/>
              </DockPanel>

              <CheckBox x:Name="MatchLocalSwitch" Style="{StaticResource Switch}" Margin="0">
                <StackPanel>
                  <TextBlock Text="Describe my local files in the patch digest" FontWeight="SemiBold"/>
                  <TextBlock Text="Recommended for a modified or partial install, so the client does not try to download what it already has." Style="{StaticResource Hint}"/>
                </StackPanel>
              </CheckBox>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <StackPanel>
              <TextBlock Text="RPCS3" Style="{StaticResource CardTitle}"/>

              <TextBlock Text="rpcs3.exe" Style="{StaticResource FieldLabel}"/>
              <DockPanel Margin="0,0,0,14">
                <Button DockPanel.Dock="Right" Content="Browse" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="BrowseRpcs3_Click"/>
                <TextBox x:Name="Rpcs3Box"/>
              </DockPanel>

              <TextBlock Text="Game (game.elf)" Style="{StaticResource FieldLabel}"/>
              <DockPanel Margin="0,0,0,14">
                <Button DockPanel.Dock="Right" Content="Browse" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="BrowseElf_Click"/>
                <TextBox x:Name="ElfBox"/>
              </DockPanel>

              <CheckBox x:Name="RestoreScriptsSwitch" Style="{StaticResource Switch}" Margin="0">
                <StackPanel>
                  <TextBlock Text="Restore the original game scripts before a test run" FontWeight="SemiBold"/>
                  <TextBlock Text="Puts ui\scriptsbase.bin.sdat back from its .orig copy when a patched one is in place." Style="{StaticResource Hint}"/>
                </StackPanel>
              </CheckBox>

              <CheckBox x:Name="InstallPatchesSwitch" Style="{StaticResource Switch}" Margin="0,12,0,0">
                <StackPanel>
                  <TextBlock Text="Add the game fixes to RPCS3 before a test run" FontWeight="SemiBold"/>
                  <TextBlock Text="Adds and turns on the keyboard fix (custom names), the renderer crash guard and the character wheel in RPCS3's game patches. Patches you turned off stay off." Style="{StaticResource Hint}" TextWrapping="Wrap"/>
                </StackPanel>
              </CheckBox>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="NETWORK" Style="{StaticResource CardTitle}"/>
              <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition/>
                  <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,8,0">
                  <TextBlock Text="Listen on" Style="{StaticResource FieldLabel}"/>
                  <TextBox x:Name="BindBox"/>
                  <TextBlock Text="127.0.0.1 for this PC, 0.0.0.0 for your network." Style="{StaticResource Hint}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                  <TextBlock Text="Address the PS3 connects to" Style="{StaticResource FieldLabel}"/>
                  <TextBox x:Name="AdvertiseBox"/>
                  <TextBlock Text="This PC's IPv4 address as the console sees it." Style="{StaticResource Hint}"/>
                </StackPanel>
              </Grid>
              <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition/>
                  <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,8,0">
                  <TextBlock Text="Web server port (TCP)" Style="{StaticResource FieldLabel}"/>
                  <TextBox x:Name="HttpPortBox"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                  <TextBlock Text="Game server port (UDP)" Style="{StaticResource FieldLabel}"/>
                  <TextBox x:Name="GatewayPortBox"/>
                </StackPanel>
              </Grid>
              <CheckBox x:Name="DnsSwitch" Style="{StaticResource Switch}" Margin="0">
                <StackPanel>
                  <TextBlock Text="Run the DNS stand-in (UDP 53)" FontWeight="SemiBold"/>
                  <TextBlock Text="Points the game's host names at this PC. Turn off only if you run your own DNS." Style="{StaticResource Hint}"/>
                </StackPanel>
              </CheckBox>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- Logs -->
      <DockPanel x:Name="PageLogs" Visibility="Collapsed">
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="Logs" Style="{StaticResource PageTitle}"/>
          <TextBlock Text="Everything the server does, as it happens." Style="{StaticResource PageSubtitle}"/>
        </StackPanel>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button x:Name="PauseButton" Content="Pause" Style="{StaticResource SecondaryButton}" Padding="12,6" Click="Pause_Click"/>
            <Button Content="Copy" Style="{StaticResource SecondaryButton}" Padding="12,6" Click="CopyLog_Click"/>
            <Button Content="Clear" Style="{StaticResource SecondaryButton}" Padding="12,6" Margin="0" Click="ClearLog_Click"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBox x:Name="SearchBox" Width="260" Margin="0,0,12,0" TextChanged="LogFilter_Changed" ToolTip="Search"/>
            <RadioButton x:Name="LevelAll" Style="{StaticResource Segment}" GroupName="Level" Content="All" IsChecked="True" Checked="LogFilter_Changed"/>
            <RadioButton x:Name="LevelWarnings" Style="{StaticResource Segment}" GroupName="Level" Content="Warnings" Checked="LogFilter_Changed"/>
            <RadioButton x:Name="LevelErrors" Style="{StaticResource Segment}" GroupName="Level" Content="Errors" Checked="LogFilter_Changed"/>
            <Border Width="12"/>
            <RadioButton x:Name="SourceAll" Style="{StaticResource Segment}" GroupName="Source" Content="All sources" IsChecked="True" Checked="LogFilter_Changed"/>
            <RadioButton x:Name="SourceGame" Style="{StaticResource Segment}" GroupName="Source" Content="Game server" Checked="LogFilter_Changed"/>
            <RadioButton x:Name="SourceWeb" Style="{StaticResource Segment}" GroupName="Source" Content="Web and DNS" Checked="LogFilter_Changed"/>
          </StackPanel>
        </DockPanel>
        <Border Style="{StaticResource Card}" Padding="0" Background="{StaticResource InputBrush}">
          <ListBox x:Name="LogList" Background="Transparent" BorderThickness="0" Padding="8"
                   VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72"/>
                    <ColumnDefinition Width="58"/>
                    <ColumnDefinition Width="104"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="{Binding TimeText}" Foreground="{StaticResource MutedBrush}" FontFamily="{StaticResource MonoFont}" FontSize="12"/>
                  <TextBlock Grid.Column="1" x:Name="Level" Text="{Binding SeverityText}" Foreground="{StaticResource MutedBrush}" FontFamily="{StaticResource MonoFont}" FontSize="12"/>
                  <TextBlock Grid.Column="2" Text="{Binding Source}" Foreground="{StaticResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Column="3" x:Name="Message" Text="{Binding Message}" FontFamily="{StaticResource MonoFont}" FontSize="12" TextWrapping="Wrap"/>
                </Grid>
                <DataTemplate.Triggers>
                  <DataTrigger Binding="{Binding Severity}" Value="Warning">
                    <Setter TargetName="Level" Property="Foreground" Value="{StaticResource WarningBrush}"/>
                    <Setter TargetName="Message" Property="Foreground" Value="{StaticResource WarningBrush}"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Severity}" Value="Error">
                    <Setter TargetName="Level" Property="Foreground" Value="{StaticResource DangerBrush}"/>
                    <Setter TargetName="Message" Property="Foreground" Value="{StaticResource DangerBrush}"/>
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Border>
      </DockPanel>

      <!-- Diagnostics -->
      <ScrollViewer x:Name="PageDiagnostics" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="820" HorizontalAlignment="Left">
          <TextBlock Text="Diagnostics" Style="{StaticResource PageTitle}"/>
          <TextBlock Text="Reports to attach when something goes wrong, and where the files are." Style="{StaticResource PageSubtitle}"/>

          <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <DockPanel>
              <Button DockPanel.Dock="Right" x:Name="TestRunButton2" Content="Start test run" Style="{StaticResource PrimaryButton}" Margin="16,0,0,0" VerticalAlignment="Center" Click="TestRun_Click"/>
              <StackPanel>
                <TextBlock Text="Test run in RPCS3" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="Starts the server if needed and RPCS3 on the game. Play, then close RPCS3: a report zip with the server log, RPCS3's log and the traces is saved to your Desktop." Style="{StaticResource Hint}"/>
              </StackPanel>
            </DockPanel>
          </Border>

          <Border Style="{StaticResource Card}" Margin="0,0,0,16">
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="Export now" Style="{StaticResource SecondaryButton}" Margin="16,0,0,0" VerticalAlignment="Center" Click="Export_Click"/>
              <StackPanel>
                <TextBlock Text="Export diagnostics" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="Saves the logs and traces as they are right now to a zip on your Desktop, without starting RPCS3." Style="{StaticResource Hint}"/>
              </StackPanel>
            </DockPanel>
          </Border>

          <Border x:Name="LastReportCard" Style="{StaticResource Card}" Margin="0,0,0,16" Visibility="Collapsed">
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="Show in folder" Style="{StaticResource SecondaryButton}" Margin="16,0,0,0" VerticalAlignment="Center" Click="ShowReport_Click"/>
              <StackPanel>
                <TextBlock Text="Last report" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock x:Name="LastReportText" Style="{StaticResource Hint}" FontFamily="{StaticResource MonoFont}"/>
              </StackPanel>
            </DockPanel>
          </Border>

          <Border Style="{StaticResource Card}">
            <StackPanel>
              <TextBlock Text="FOLDERS AND UPDATES" Style="{StaticResource CardTitle}"/>
              <WrapPanel>
                <Button Content="Open trace files" Style="{StaticResource SecondaryButton}" Click="OpenTraces_Click" Margin="0,0,8,8"/>
                <Button Content="Open settings folder" Style="{StaticResource SecondaryButton}" Click="OpenData_Click" Margin="0,0,8,8"/>
                <Button Content="Check for updates" Style="{StaticResource SecondaryButton}" Click="Updates_Click" Margin="0,0,8,8"/>
              </WrapPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

    </Grid>
  </Grid>
</Window>
